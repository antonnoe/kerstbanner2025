# --- Admin-login (HTTP Basic Auth op /admin/* en /api/admin/*) ---
# Eén login; de browser onthoudt de credentials.
ADMIN_USER=anton
ADMIN_PASS=kies-een-sterk-wachtwoord

# --- Supabase (project: communities-tools) ---
# Backend + dashboard gebruiken uitsluitend de service-role-key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (monitor-alerts) ---
RESEND_API_KEY=
# Afzender voor alert-mails. Default huisstijl: noreply@nederlanders.fr
RESEND_FROM=noreply@nederlanders.fr
# Ontvanger van monitor-alerts (fallback als instellingen-tabel leeg is).
ADMIN_EMAIL=antonnoe@gmail.com

# --- Cron-beveiliging ---
# Vercel stuurt deze automatisch mee als Bearer-token op cron-runs.
CRON_SECRET=

# --- Publieke site-URL (voor links in alert-mails) ---
# Bv https://nlfr-if-distributie.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
