# Supabase (project: communities-tools)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — used for monitor-alerts (NIET voor magic-link; die loopt via Supabase SMTP).
RESEND_API_KEY=
# Afzender voor alert-mails. Default huisstijl: noreply@nederlanders.fr
ALERT_FROM_EMAIL=noreply@nederlanders.fr

# Fallback admin-email indien geen waarde in de instellingen-tabel staat.
ADMIN_EMAIL=antonnoe@gmail.com

# Cron-beveiliging. Vercel stuurt deze automatisch mee als Bearer-token op cron-runs.
CRON_SECRET=

# Publieke site-URL (voor magic-link redirect). Bv https://nlfr-if-distributie.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
